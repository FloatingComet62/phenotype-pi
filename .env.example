# Main backend, reached over Tailscale from this Pi.
MAIN_BACKEND_URL=http://100.x.x.x:8000/api/v1
INGEST_API_KEY=change-me-dev-key

# DHT sensor polling
DHT_HOSTS=dht1.local,dht2.local,dht3.local
DHT_POLL_INTERVAL_SECONDS=60
DHT_READING_PATH=/reading
DHT_TEMP_FIELD=temperature_c
DHT_HUMIDITY_FIELD=humidity_percent

# Camera capture (periodic stills, not live streaming)
CAMERA_ENABLED=false
CAMERA_ID=1
CAMERA_BACKEND=picamera2
CAMERA_DEVICE_INDEX=0
CAPTURE_INTERVAL_SECONDS=17280
# = 24h / 5 -- five captures/day, feeding the CV pipeline (see cv_pipeline.py
# on the main backend). Lower this if you also want more frequent snapshots
# purely for the "latest image" display; the CV analysis runs on every
# capture regardless of interval.

# Relay proxy -- lets the main backend toggle relays over mDNS
RELAY_PROXY_ENABLED=true
RELAY_HOST=relay.local
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8090

REQUEST_TIMEOUT_SECONDS=8
EXHAUST_FAN_HOST=
EXHAUST_FAN_CHANNEL=1
